# AI Workmate - Environment Variables
# Copy this file to .env and fill in your values

# App
APP_NAME="AI Workmate"
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL="sqlite+aiosqlite:///./data/ai-workmate.db"
DB_ECHO=false

# Microsoft Graph (Work/School only - organizations endpoint)
# Register at https://portal.azure.com/
# Authentication > Add a platform > Mobile and desktop applications > Redirect URI: http://localhost:8000/api/v1/auth/callback
MS_GRAPH_CLIENT_ID="your-client-id-here"
MS_GRAPH_CLIENT_SECRET="your-client-secret-here"
MS_GRAPH_TENANT_ID="organizations"
MS_GRAPH_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback"
MS_GRAPH_SCOPES="Mail.Read Mail.ReadWrite Calendars.Read Contacts.Read User.Read"

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_MASTER_KEY=""

# Ollama (local AI)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="phi3:3.8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Qdrant (local embedded vector DB)
QDRANT_PATH="./data/qdrant"

# Sync
SYNC_INTERVAL_MINUTES=5
SYNC_BATCH_SIZE=100
DELTA_SYNC_ENABLED=true

# AI
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
AI_CONFIDENCE_AUTO_CREATE=95
AI_CONFIDENCE_SUGGEST=80

# Notifications
NOTIFICATION_CHECK_INTERVAL_MINUTES=1
DAILY_BRIEFING_HOUR=8
END_OF_DAY_HOUR=18

# Logging
LOG_LEVEL=INFO
LOG_FILE="./logs/ai-workmate.log"
LOG_ROTATION="10 MB"
LOG_RETENTION="7 days"

# Tauri
TAURI_BACKEND_PORT=8000